# =============================================================================
# Practical 11 Supplementary: Optimized Multi-Stage Nginx Build
# Reduces image size from ~450MB (Node runtime) down to ~25MB (Nginx Alpine)
# =============================================================================

# Stage 1: Build Phase
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Production Dist Phase (Zero Node.js overhead)
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173
CMD ["nginx", "-g", "daemon off;"]

